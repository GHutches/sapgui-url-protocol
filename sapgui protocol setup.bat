# A powershell script wrapper for SAPGUI's sapshcut.exe to implement a url protocol. The url protocol is 'sapgui:'.

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type -AssemblyName PresentationFramework
[System.Windows.Forms.Application]::EnableVisualStyles() | Out-Null

$DPISetting = (Get-ItemProperty 'HKCU:\Control Panel\Desktop\WindowMetrics' -Name AppliedDPI).AppliedDPI
$dpiScaleFactor = $DPISetting/96

#Enable DPI awareness
$code = @"
    [System.Runtime.InteropServices.DllImport("user32.dll")]
    public static extern bool SetProcessDPIAware();
"@
$Win32Helpers = Add-Type -MemberDefinition $code -Name "Win32Helpers" -PassThru
$null = $Win32Helpers::SetProcessDPIAware()

#----------------------------------------------------------------------------------------------
# Functions
#----------------------------------------------------------------------------------------------

function Get-FileName{
    param(
        [Parameter(Mandatory, Position=0, ValueFromPipeline)]
        [PSTypeName('System.Windows.Forms.TextBox')]
        [psobject]$textBox
    )

    [System.Reflection.Assembly]::LoadWithPartialName("System.windows.forms") | Out-Null
    $OpenFileDialog = New-Object System.Windows.Forms.OpenFileDialog
    $initialPath = $textBox.Text
    if ([string]::IsNullOrEmpty([System.IO.Path]::GetExtension($sapPath))) {
        $initialPath = $initialPath + '.exe'
    } 
    
    if ([System.IO.File]::Exists($initialPath)) {
        $OpenFileDialog.initialDirectory = [System.IO.Path]::GetDirectoryName($initialPath)
    } else {
        $OpenFileDialog.initialDirectory = "C:\" 
    }
    $OpenFileDialog.filter = "EXE Files (*.exe)|*.exe|All Files (*.*)|*.*"
    
    if ($OpenFileDialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $textBox.Text = $OpenFileDialog.FileName
    }
}

#----------------------------------------------------------------------------------------------
# DPI handling
#----------------------------------------------------------------------------------------------
$dpiChangedEventHandler = {
    $dpiCoef = $EventArgs.DeviceDpiNew / $EventArgs.DeviceDpiOld
    $sender.Font = New-Object System.Drawing.Font($sender.Font.Name,($sender.Font.Size*$dpiCoef),$sender.Font.Style)
    $sender.Size = New-Object System.Drawing.Size(($sender.Size.Width*$dpiCoef),($sender.Size.Height*$dpiCoef))
    if ((-not ($sender -is [System.Windows.Forms.Form])) -and (Get-Member -inputobject $sender -name "Location" -Membertype Properties)) {   
        $sender.Location = New-Object System.Drawing.Point(($sender.Location.X*$dpiCoef), ($sender.Location.Y*$dpiCoef))
    }
}
