#check to see if SAP GUI is installed. Warn user that SAP GUI may not be installed.
Write-Host "Checking to see if SAP GUI is installed."
try {
    get-package 'Sap Gui*' -ErrorAction Stop
} catch {
    [System.Windows.MessageBox]::Show("Error: sapgui_protocolhandler `n`nSAP GUI installation not found. Please verify that sapshcut.exe is installed and functioning.`n`nURL Protocol can still be installed, but it may not be using a functioning sapshcut.exe.",'Error','OK','Error')  | Out-Null
}

#check to see if protocol already has values. Return empty if registry key does not exist.
try {
    $command = (Get-ItemProperty -Path "HKCU:\SOFTWARE\Classes\sapgui\shell\open\command" -ErrorAction Stop)."(default)"
} catch {
    $command = ''
}

if ([string]::IsNullOrEmpty($command)) {
#protocol command not installed, initialize with default variables.
    $user = ""
    $dateformat = "dd.MM.yyyy"
    $sysname = "- OneWINS - PCE [SSO]"
    $system = "PCE"
    $client = "017"
    $language = "EN"
    $sapPath = "C:\Program Files (x86)\SAP\FrontEnd\SAPgui\sapshcut.exe"
} else {
    #get user from command string
    if ($command -match "(?:-user|-u)=(\S+)") {
        $user = ($Matches.1).replace("'",'').replace("`"",'').replace('&&','&')
    } else {
        $user = ""
    }

    #get dateformat from command string
    if ($command -match "\`$dt\.ToString\((.*?)\)") {
        $dateformat = ($Matches.1).replace("'",'').replace("`"",'').replace('&&','&')
    } else {
        $dateformat = ""
    }

    #get sysname from command string
    if ($command -match "(?:-sysname|-desc)=(`"`"`".*?`"`"`"|\S+)") {
        $sysname = ($Matches.1).replace("'",'').replace("`"",'').replace('&&','&')
    } else {
        $sysname = "- OneWINS - PCE [SSO]"
    }

    #get system from command string
    if ($command -match "(?:-system|-sid)=(\S+)") {
        $system = ($Matches.1).replace("'",'').replace("`"",'').replace('&&','&')
    } else {
        $system = "PCE"
    }

    #get client from command string
    if ($command -match "(?:-client|-clt)=(\S+)") {
        $client = ($Matches.1).replace("'",'').replace("`"",'').replace('&&','&')
    } else {
        $client = "017"
    }

    #get language from command string
    if ($command -match "(?:-language|-l)=(\S+)") {
        $language = ($Matches.1).replace("'",'').replace("`"",'').replace('&&','&')
    } else {
        $language = "EN"
    }

    #get sapPath from command string
    if ($command -match "&(`".+?`"|'.+?'|\S+).* \`$args\.split\('&'\)") {
        $sapPath = ($Matches.1).replace("'",'').replace("`"",'')
        if ([string]::IsNullOrEmpty([System.IO.Path]::GetExtension($sapPath))) {
            if (-not (Test-Path $sapPath'.exe')) {
                $sapPath = "C:\Program Files (x86)\SAP\FrontEnd\SAPgui\sapshcut.exe"
                $command = ''
            }
        } else {
            If (-not (Test-Path $sapPath)) {
                $sapPath = "C:\Program Files (x86)\SAP\FrontEnd\SAPgui\sapshcut.exe"
                $command = ''
            }
        }
    } else {
        $sapPath = "C:\Program Files (x86)\SAP\FrontEnd\SAPgui\sapshcut.exe"
        $command = ''
    }
}

